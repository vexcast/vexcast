  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @vexcast/desktop dev",
    "build:ui": "pnpm --filter @vexcast/desktop build",
    "tauri": "pnpm --filter @vexcast/desktop tauri",
