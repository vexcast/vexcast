{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vexcast",
  "version": "../package.json",
  "identifier": "app.vexcast.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vexcast",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#07080f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:* https:; media-src 'self' blob: http://127.0.0.1:*; frame-src http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Vexcast",
    "homepage": "https://github.com/vexcast/vexcast",
    "license": "GPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "Free, open-source, local-first live-streaming studio",
    "longDescription": "Vexcast is a free and open-source live-streaming studio: scenes and sources, multistreaming to Twitch, YouTube, Kick, TikTok and more, unified chat, alerts and widgets, a chat bot and local AI (voice, co-host, moderation and live captions).",
    "copyright": "Copyright © Vexcast contributors. Licensed under the GPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      },
      "rpm": {
        "depends": [
          "ffmpeg"
        ]
      }
    },
    "resources": [
      "resources/*"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vexcast/vexcast/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMzY2NjdCNERGNDNDODkKUldTSlBQUk5lMlkybThRTmU3M3czdWFZZEdDQ2o3TUJPc3dOYnR4UVQyMkRicXExREd2TW9ucDgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
